# 复制为 .env 后填写真实值；.env 已被 .gitignore 忽略，切勿提交到仓库。
# 生成强随机值：openssl rand -hex 24
# 密码请只用字母数字（hex），避免 @ : / # 等字符破坏 MySQL DSN / Redis 配置。
# 本文件只含占位符，不含任何真实凭据。

APP_VERSION=v1.0.0

# 可选：国内服务器若拉不到 Docker Hub，在此替换为可访问的基础镜像源
# GO_IMAGE=registry.example.com/library/golang:1.22-alpine
# RUNTIME_IMAGE=registry.example.com/library/alpine:3.20

# MySQL：应用使用 MYSQL_USER（最小权限），root 仅用于容器初始化
MYSQL_DATABASE=small_commerce_order
MYSQL_USER=appuser
MYSQL_PASSWORD=CHANGE_ME_mysql_app_strong_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_strong_password

# Redis：生产必须设置密码，会话令牌只存于此
REDIS_PASSWORD=CHANGE_ME_redis_strong_password

# 支付渠道验签密钥：至少 32 字节随机串，不得与 demo-channel-secret 相同
APP_CHANNEL_SECRET=CHANGE_ME_at_least_32_bytes_random_hex

# 6 个预置账号密码，格式「用户ID:密码」，逗号分隔；密码内不要含逗号或冒号
APP_PASSWORDS=u001:CHANGE_ME_1,u002:CHANGE_ME_2,u003:CHANGE_ME_3,admin:CHANGE_ME_4,wh:CHANGE_ME_5,cs:CHANGE_ME_6
